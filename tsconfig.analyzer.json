{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist/analyzer",
    "rootDir": "analyzer",
    "types": ["node"]
  },
  "include": ["analyzer/**/*.ts"]
}
